# Painel do Spotify: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Endereço onde o app roda. O Spotify exige 127.0.0.1 (e não "localhost") em http.
# Quando publicar ou usar um túnel (ngrok etc.), troque aqui e no painel do Spotify.
BASE_URL=http://127.0.0.1:3000
PORT=3000

# Uma frase longa e aleatória, só sua.
SESSION_SECRET=troque-por-algo-bem-aleatorio

# Limite de pessoas por grupo (o modo de desenvolvimento do Spotify permite 5).
MAX_GROUP_SIZE=5
